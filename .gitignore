# Client-facing repository allowlist. Only the shipped static client, its
# deployment configuration, and this ignore policy belong on the branch.
/*
!/.gitignore
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/deploy.yml
!/src/
!/src/**
!/vercel.json

# --- OS ---------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# --- Editors ----------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# --- Licensed typefaces -----------------------------------------------------
# Suisse Intl may be dropped in locally but must not be redistributed.
src/assets/fonts/SuisseIntl-*

# --- Generated output --------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/

# --- Browser automation -----------------------------------------------------
# Playwright and friends, if a future harness reaches for them.
node_modules/
test-results/
playwright-report/
blob-report/
.playwright/

# --- Local environments -----------------------------------------------------
.env
.env.*
venv/
.venv/

# --- Deploy -----------------------------------------------------------------
.vercel/
.netlify/
dist/
build/

# --- Working files ----------------------------------------------------------
# Design sources and recordings are references, not deliverables — they are
# read once to extract numbers and assets, and the numbers live in the CSS.
*.fig
*.mp4
*.mov
*.webm
*.zip
*.log
.cache/
tmp/
scratch/
